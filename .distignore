# A set of files you probably don't want in your WordPress.org distribution.
#
# Read by two tools: `wp dist-archive` (zip) and the wp.org deploy action
# (`rsync --exclude-from`). Directories are listed by bare name, not `name/*`:
# under rsync, `name/*` drops only the contents and still ships the directory
# itself, which is how 1.4.1 and 1.4.2 reached wp.org with empty .git, .github,
# .wordpress-org, bin, config, controls, node_modules and src folders. A bare
# name excludes the whole directory under both tools.

# --- Version control ---
.git
# In a submodule, `.git` is a FILE (a gitdir pointer), not a directory. dist-archive
# rewrites the bare `.git` line to `.git/*` because the plugin root's own .git IS
# a directory, so the nested form below is what matches lib/style-handler/.git
# and controls/.git in the zip.
*/.git
.gitignore
.gitattributes
.gitmodules
.github
.gitlab-ci.yml

# --- Editor / OS ---
.editorconfig
.DS_Store
Thumbs.db

# --- Build tooling config ---
.babelrc
.babelrc.js
babel.config.js
webpack.config.js
Gruntfile.js
gulpfile.js
postcss.config.js

# --- Lint / format config ---
.eslintignore
.eslintrc
.eslintrc.js
.eslintcache
.prettierrc
.stylelintrc
.phpcs.xml
.phpcs.xml.dist
phpcs.xml
phpcs.xml.dist

# --- Package manifests & lockfiles ---
package.json
package-lock.json
yarn.lock
pnpm-lock.yaml
composer.json
composer.lock
node_modules
vendor

# --- Source: compiled into dist/ at build time, not needed at runtime ---
src
config
controls
util

# --- Sourcemaps (never needed in production) ---
*.map

# --- Tests & CI ---
tests
bin
behat.yml
phpunit.xml
phpunit.xml.dist
multisite.xml
multisite.xml.dist
.travis.yml
bitbucket-pipelines.yml
.circleci
dependencies.yml
wp-cli.local.yml
.deployignore
.distignore

# --- Repo docs & wp.org listing assets (not part of the plugin) ---
*.md
.wordpress-org
changes.txt

# --- Archives & dumps ---
*.sql
*.tar.gz
*.zip

# --- Dead build output (never registered or enqueued) ---
dist/frontend.js
dist/frontend.asset.php
