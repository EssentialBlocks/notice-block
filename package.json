{
	"name": "notice",
	"version": "1.4.1",
	"description": "Example block written with ESNext standard and JSX support – build step required.",
	"author": "WPDeveloper",
	"license": "GPL-2.0-or-later",
	"main": "Gruntfile.js",
	"engines": {
		"node": ">=20.19.0"
	},
	"scripts": {
		"ensure-submodules": "node bin/ensure-submodules.js",
		"prepare": "node bin/ensure-submodules.js --soft",
		"prebuild": "npm run ensure-submodules",
		"build": "set NODE_ENV=production && wp-scripts build",
		"prestart": "npm run ensure-submodules",
		"predist": "npm run ensure-submodules",
		"dist": "wp dist-archive . ./notice-block.zip --format=zip",
		"postdist": "node bin/verify-package.js ./notice-block.zip",
		"format:js": "wp-scripts format-js",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"start": "wp-scripts start",
		"packages-update": "wp-scripts packages-update"
	},
	"devDependencies": {
		"@babel/plugin-transform-class-properties": "^7.24.1",
		"@babel/preset-env": "^7.16.0",
		"@babel/preset-react": "^7.16.0",
		"@wordpress/block-editor": "^8.0.12",
		"@wordpress/blocks": "^11.1.5",
		"@wordpress/i18n": "^4.2.4",
		"@wordpress/scripts": "^19.2.2",
		"mini-css-extract-plugin": "^2.5.0"
	}
}
